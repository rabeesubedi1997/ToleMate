# Fallback for cPanel subdomain root (/home/vertexen/tolemate.kitetool.com)
# Only active when the Document Root cannot be set to .../backend/public.
# Forwards all non-backend requests into the Laravel public folder.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/backend/
    RewriteRule ^(.*)$ backend/public/$1 [L]
</IfModule>
